 "fields": [
  {
   "fieldname": "status_section",
   "fieldtype": "Section Break",
   "label": "Setup Status & Guide"
  },
  {
   "fieldname": "setup_html",
   "fieldtype": "HTML",
   "label": "Setup"
  },
  {
   "fieldname": "provider_section",
   "fieldtype": "Section Break",
   "label": "Meeting Provider"
  },
  {
   "fieldname": "default_provider",
   "fieldtype": "Select",
   "label": "Default Provider",
   "options": "Google Meet\nManual Link",
   "default": "Google Meet",
   "description": "Zoom and Microsoft Teams are coming soon. Other apps can add providers through a hook - see docs/ADDING_A_PROVIDER.md."
  },
  {
   "fieldname": "default_duration",
   "fieldtype": "Int",
   "label": "Default Duration (minutes)",
   "default": "30"
  },
  {
   "fieldname": "default_add_video_meeting",
   "fieldtype": "Check",
   "label": "Add a video meeting by default",
   "default": "1"
  },
  {
   "fieldname": "google_section",
   "fieldtype": "Section Break",
   "label": "Google Calendar / Google Meet"
  },
  {
   "fieldname": "google_calendar",
   "fieldtype": "Link",
   "label": "Company Google Calendar",
   "options": "Google Calendar",
   "description": "Connected once by an admin under Google Calendar. All meetings are created on this calendar, so sales users never have to log in to Google."
  },
  {
   "fieldname": "use_personal_calendars",
   "fieldtype": "Check",
   "label": "Use each user's own Google Calendar when they have one",
   "default": "0",
   "description": "Off: every meeting is created on the company calendar above. On: a user with their own connected Google Calendar organizes their own meetings."
  },
  {
   "fieldname": "notify_section",
   "fieldtype": "Section Break",
   "label": "Notifications & Reminders"
  },
  {
   "fieldname": "notify_on_schedule",
   "fieldtype": "Check",
   "label": "Send in-app CRM notifications when a meeting is scheduled, changed or cancelled",
   "default": "1"
  },
  {
   "fieldname": "reminders_enabled",
   "fieldtype": "Check",
   "label": "Send reminders before a meeting starts",
   "default": "1"
  },
  {
   "fieldname": "reminder_minutes_before",
   "fieldtype": "Int",
   "label": "Reminder (minutes before)",
   "default": "30",
   "depends_on": "reminders_enabled"
  },
  {
   "fieldname": "early_reminder_minutes",
   "fieldtype": "Int",
   "label": "Early reminder (minutes before, 0 = off)",
   "default": "0",
   "depends_on": "reminders_enabled",
   "description": "For example 1440 sends a second reminder one day before."
  },
  {
   "fieldname": "column_break_notify",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "email_reminders",
   "fieldtype": "Check",
   "label": "Email reminders to CRM team members",
   "default": "1",
   "depends_on": "reminders_enabled"
  },
  {
   "fieldname": "remind_guests",
   "fieldtype": "Check",
   "label": "Also email reminders to external guests",
   "default": "0",
   "depends_on": "reminders_enabled"
  },
  {
   "fieldname": "ui_section",
   "fieldtype": "Section Break",
   "label": "CRM Interface"
  },
  {
   "fieldname": "show_record_buttons",
   "fieldtype": "Check",
   "label": "Show a \"Schedule Meeting\" button on Lead and Deal pages",
   "default": "1",
   "description": "Turn this off if your CRM already has a Meetings tab."
  },
  {
   "fieldname": "show_list_button",
   "fieldtype": "Check",
   "label": "Show a \"Meetings\" button on the Leads and Deals list pages",
   "default": "1"
  }
